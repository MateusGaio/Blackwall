{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Blackwall",
  "version": "0.1.0",
  "identifier": "com.mateusgaio.blackwall",
  "build": {
    "beforeDevCommand": "npm run dev -- --host 127.0.0.1 --port 1420",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build && npm run prepare:desktop-runtime",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Blackwall",
        "width": 1100,
        "height": 760,
        "minWidth": 700,
        "minHeight": 540,
        "decorations": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:* ws://127.0.0.1:*; style-src 'self' 'unsafe-inline'; img-src 'self' asset:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["appimage", "deb"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../desktop-runtime": "desktop-runtime"
    }
  }
}
