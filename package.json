{
  "name": "blackwall",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run build:sidecar && node scripts/dev-web.mjs",
    "dev:desktop": "node scripts/dev-desktop.mjs",
    "build": "tsc -p tsconfig.app.json && vite build && npm run build:sidecar",
    "build:sidecar": "tsc -p sidecar/tsconfig.json",
    "prepare:desktop-runtime": "node scripts/prepare-desktop-runtime.mjs",
    "smoke:desktop-runtime": "node scripts/smoke-desktop-runtime.mjs",
    "build:desktop": "tauri build",
    "verify:release-version": "node scripts/verify-release-version.mjs",
    "db:generate": "drizzle-kit generate",
    "e2e": "playwright test",
    "e2e:ci": "node scripts/run-e2e-ci.mjs",
    "e2e:install": "playwright install chromium",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "knip": "knip",
    "depcruise": "depcruise --config .dependency-cruiser.cjs src sidecar",
    "arch-contract": "npm run depcruise",
    "mutation": "stryker run",
    "check": "npm run lint && npm run knip && npm run arch-contract && npm test",
    "prepare": "husky"
  },
  "dependencies": {
    "@assistant-ui/react": "^0.15.16",
    "@chenglou/pretext": "^0.0.8",
    "@opentelemetry/api": "^1.9.0",
    "@tauri-apps/api": "^2.9.1",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "better-sqlite3": "^13.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "d3-force": "^3.0.0",
    "drizzle-orm": "^0.45.2",
    "i18next": "^25.5.2",
    "lucide-react": "^1.33.0",
    "pdf-parse": "^2.4.5",
    "radix-ui": "^1.6.7",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-i18next": "^16.0.0",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^4.12.3",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "ws": "^8.18.3",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.0",
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@playwright/test": "^1.62.1",
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/vitest-runner": "^9.6.1",
    "@tailwindcss/vite": "^4.1.13",
    "@tauri-apps/cli": "^2.9.5",
    "@types/better-sqlite3": "^9.6.0",
    "@types/d3-force": "^3.0.10",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.0.4",
    "@vitest/coverage-v8": "^3.2.4",
    "dependency-cruiser": "^18.2.0",
    "drizzle-kit": "^0.31.10",
    "husky": "^9.1.7",
    "knip": "^5.64.0",
    "shadcn": "^4.19.0",
    "tailwindcss": "^4.1.13",
    "typescript": "^5.9.3",
    "vite": "^7.1.7",
    "vitest": "^3.2.4"
  }
}
