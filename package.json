{
  "name": "blackwall",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:desktop": "tauri dev",
    "build": "tsc -p tsconfig.app.json && vite build && npm run build:sidecar",
    "build:sidecar": "tsc -p sidecar/tsconfig.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "knip": "knip",
    "depcruise": "depcruise --config .dependency-cruiser.cjs src sidecar",
    "check": "npm run lint && npm run knip && npm run depcruise && npm test",
    "prepare": "husky"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.9.1",
    "@opentelemetry/api": "^1.9.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.0",
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@tauri-apps/cli": "^2.9.5",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/ws": "^8.18.1",
    "@tailwindcss/vite": "^4.1.13",
    "@vitejs/plugin-react": "^5.0.4",
    "dependency-cruiser": "^17.2.0",
    "husky": "^9.1.7",
    "knip": "^5.64.0",
    "typescript": "^5.9.3",
    "tailwindcss": "^4.1.13",
    "vite": "^7.1.7",
    "@vitest/coverage-v8": "^3.2.4",
    "vitest": "^3.2.4"
  }
}
