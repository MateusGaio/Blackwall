{
  "name": "blackwall",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run build:sidecar && node scripts/dev-web.mjs",
    "dev:desktop": "tauri dev",
    "build": "tsc -p tsconfig.app.json && vite build && npm run build:sidecar",
    "build:sidecar": "tsc -p sidecar/tsconfig.json",
    "prepare:desktop-runtime": "node scripts/prepare-desktop-runtime.mjs",
    "smoke:desktop-runtime": "node scripts/smoke-desktop-runtime.mjs",
    "build:desktop": "tauri build",
    "db:generate": "drizzle-kit generate",
    "e2e": "playwright test",
    "e2e:install": "playwright install chromium",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "knip": "knip",
    "depcruise": "depcruise --config .dependency-cruiser.cjs src sidecar",
    "arch-contract": "npm run depcruise",
    "mutation": "stryker run",
    "check": "npm run lint && npm run knip && npm run arch-contract && npm test",
    "prepare": "husky"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.0",
    "@tauri-apps/api": "^2.9.1",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.2",
    "i18next": "^25.5.2",
    "pdf-parse": "^2.4.5",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-i18next": "^16.0.0",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.0",
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@playwright/test": "^1.62.1",
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/vitest-runner": "^9.6.1",
    "@tailwindcss/vite": "^4.1.13",
    "@tauri-apps/cli": "^2.9.5",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.0.4",
    "@vitest/coverage-v8": "^3.2.4",
    "dependency-cruiser": "^17.2.0",
    "drizzle-kit": "^0.31.10",
    "husky": "^9.1.7",
    "knip": "^5.64.0",
    "tailwindcss": "^4.1.13",
    "typescript": "^5.9.3",
    "vite": "^7.1.7",
    "vitest": "^3.2.4"
  }
}
